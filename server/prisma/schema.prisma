// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum EmployeeRole {
  manager
  therapist
  admin
}



enum SidebarPosition {
  left
  right
  none
}

enum CalendarAppearance {
  default
  compact
  spacious
}

enum UserRole {
  gestor
  client
}

model Company {
  id         String     @id @default(uuid())
  name       String
  businesses Business[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Business {
  id                  String               @id @default(uuid())
  name                String
  themeColor          String?
  companyId           String
  company             Company              @relation(fields: [companyId], references: [id])
  employees           Employee[]
  services            Service[]
  gestorConfig        GestorConfig?
  users               User[]
  appointments        Appointment[]
  slotWaitlistEntries SlotWaitlistEntry[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model GestorConfig {
  id                 String   @id @default(uuid())
  businessId         String   @unique
  business           Business @relation(fields: [businessId], references: [id])
  
  // Basic Config
  logoUrl            String?
  numberOfPeople     Int      @default(0)
  businessType       String?
  email              String?
  phone              String?
  address            String?
  onboardingComplete Boolean  @default(false)

  // UI / Layout Config
  sidebarPosition    SidebarPosition    @default(left)
  showNavbar         Boolean            @default(false)
  calendarAppearance CalendarAppearance @default(default)
  sidebarModuleIds   String[]           @default(["inicio", "agenda", "equipo", "centros", "config"])

  // Agenda Colors
  sameColorsForAll   Boolean            @default(true)
  agendaBg           String             @default("#ffffff")
  markedDaysColor    String             @default("#3498db")
  vacationColor      String             @default("#e74c3c")

  // Scheduler Settings
  startHour           Int                @default(9)
  endHour             Int                @default(20)
  slotDurationMinutes Int                @default(60)
  workDaysPerWeek     Int                @default(5)
  maxPeoplePerSlot    Int                @default(1)

  // Smart Filling (huecos con micro-descuento)
  smartFillingEnabled         Boolean @default(false)
  smartFillingDiscountPercent Int     @default(10)

  // WhatsApp reminders (recordatorios de cita)
  whatsappRemindersEnabled Boolean @default(false)
  whatsappPhoneNumberId    String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Employee {
  id                   String       @id @default(uuid())
  name                 String
  photoUrl             String?
  linkedInUrl          String?
  phoneNumber          String?
  email                String?
  weeklyHours          Float?
  color                String?
  role                 EmployeeRole @default(therapist)
  businessId           String
  business             Business     @relation(fields: [businessId], references: [id])
  defaultWorkStartHour Int?
  defaultWorkEndHour   Int?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
}

model Service {
  id                  String              @id @default(uuid())
  name                String
  category            String
  duration            Int
  price               Float
  description         String?
  requiresCabin       Boolean             @default(false)
  requiresTherapist   Boolean             @default(true)
  businessId          String
  business            Business            @relation(fields: [businessId], references: [id])
  appointments        Appointment[]
  slotWaitlistEntries SlotWaitlistEntry[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
}

model User {
  id           String    @id @default(uuid())
  username     String    @unique
  passwordHash String
  salt         String
  role         UserRole  @default(gestor)
  name         String?
  email        String?
  phone        String?
  businessId   String?
  business     Business? @relation(fields: [businessId], references: [id])
  sessionToken          String?
  appointments          Appointment[]
  slotWaitlistEntries   SlotWaitlistEntry[]
  waitlistNotifications WaitlistNotification[]
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Appointment {
  id              String          @id @default(uuid())
  businessId      String
  business        Business        @relation(fields: [businessId], references: [id])
  serviceId       String
  service         Service         @relation(fields: [serviceId], references: [id])
  userId          String
  user            User            @relation(fields: [userId], references: [id])
  employeeId      String?
  start           DateTime
  end            DateTime
  status          String          @default("confirmed")
  paymentStatus   String          @default("simulated_paid")
  notes           String?
  discountPercent Int?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model SlotWaitlistEntry {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  businessId    String
  business      Business @relation(fields: [businessId], references: [id])
  serviceId     String
  service       Service  @relation(fields: [serviceId], references: [id])
  preferredStart DateTime
  preferredEnd   DateTime
  createdAt     DateTime @default(now())
}

model WaitlistNotification {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  businessId String
  serviceId  String
  slotStart  DateTime
  slotEnd    DateTime
  readAt     DateTime?
  createdAt  DateTime @default(now())
}
