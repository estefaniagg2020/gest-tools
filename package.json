{
  "name": "gest-tools",
  "private": true,
  "version": "0.0.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "esbuild",
      "prisma",
      "vue-demi"
    ]
  },
  "scripts": {
    "dev": "pnpm --parallel --filter client --filter server dev",
    "dev:client": "pnpm --filter client dev",
    "dev:server": "pnpm --filter server dev",
    "build": "pnpm --filter client build && pnpm --filter server build",
    "test": "pnpm --filter client test && pnpm --filter server test",
    "test:client": "pnpm --filter client test",
    "test:server": "pnpm --filter server test",
    "test:coverage": "pnpm --filter client test:coverage && pnpm --filter server test:coverage",
    "test:e2e": "pnpm --filter client test:e2e",
    "typecheck": "pnpm --filter client typecheck",
    "format": "prettier --write \"**/*.{js,ts,vue,json,css,md}\" --ignore-path .gitignore"
  }
}
