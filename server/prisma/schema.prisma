// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum EmployeeRole {
  manager
  therapist
  admin
}



enum SidebarPosition {
  left
  right
  none
}

enum CalendarAppearance {
  default
  compact
  spacious
}

model Company {
  id         String     @id @default(uuid())
  name       String
  businesses Business[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Business {
  id           String        @id @default(uuid())
  name         String
  themeColor   String?
  companyId    String
  company      Company       @relation(fields: [companyId], references: [id])
  employees    Employee[]
  services     Service[]
  gestorConfig GestorConfig?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model GestorConfig {
  id                 String   @id @default(uuid())
  businessId         String   @unique
  business           Business @relation(fields: [businessId], references: [id])
  
  // Basic Config
  logoUrl            String?
  numberOfPeople     Int      @default(0)
  businessType       String?
  email              String?
  phone              String?
  address            String?
  onboardingComplete Boolean  @default(false)

  // UI / Layout Config
  sidebarPosition    SidebarPosition    @default(left)
  showNavbar         Boolean            @default(false)
  calendarAppearance CalendarAppearance @default(default)
  sidebarModuleIds   String[]           @default(["inicio", "agenda", "equipo", "centros", "config"])

  // Agenda Colors
  sameColorsForAll   Boolean            @default(true)
  agendaBg           String             @default("#ffffff")
  markedDaysColor    String             @default("#3498db")
  vacationColor      String             @default("#e74c3c")

  // Scheduler Settings
  startHour           Int                @default(9)
  endHour             Int                @default(20)
  slotDurationMinutes Int                @default(60)
  workDaysPerWeek     Int                @default(5)
  maxPeoplePerSlot    Int                @default(1)

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Employee {
  id                   String       @id @default(uuid())
  name                 String
  photoUrl             String?
  linkedInUrl          String?
  phoneNumber          String?
  email                String?
  weeklyHours          Float?
  color                String?
  role                 EmployeeRole @default(therapist)
  businessId           String
  business             Business     @relation(fields: [businessId], references: [id])
  defaultWorkStartHour Int?
  defaultWorkEndHour   Int?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
}

model Service {
  id                String          @id @default(uuid())
  name              String
  category          String
  duration          Int
  price             Float
  description       String?
  requiresCabin     Boolean         @default(false)
  requiresTherapist Boolean         @default(true)
  businessId        String
  business          Business        @relation(fields: [businessId], references: [id])
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}
